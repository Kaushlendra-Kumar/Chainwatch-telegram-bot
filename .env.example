# Copy to .env for local development. Never commit .env.

APP_ENV=development
LOG_LEVEL=debug
PORT=8080

# From @BotFather. Use a separate DEV bot locally and a PROD bot on Render.
TELEGRAM_BOT_TOKEN=

# polling = local (no public URL needed), webhook = production on Render
BOT_MODE=polling
# Only needed in webhook mode. On Render this is filled automatically from RENDER_EXTERNAL_URL.
PUBLIC_URL=
# Optional. Any random string; the Telegram secret header is derived from it.
WEBHOOK_SECRET=

# Neon: use the DIRECT (non-pooled) connection string. Locally use a "dev" branch.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Etherscan API V2 key (one key covers all EVM chains). Without it EVM tracking is disabled.
ETHERSCAN_API_KEY=
# Free tier: eth, polygon, arbitrum, linea. bsc and base need a paid plan.
EVM_CHAINS=eth,polygon,arbitrum
ETHERSCAN_RPS=2.5
ETHERSCAN_DAILY_BUDGET=90000

# CoinGecko Demo key: used for /top and as price fallback (10k calls/month).
COINGECKO_API_KEY=

# Public endpoints work without keys. A free Helius URL is far more reliable for Solana:
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPS=4
BITCOIN_API_URL=https://mempool.space/api
BINANCE_BASE_URL=https://data-api.binance.vision

PRICE_POLL_INTERVAL=30s
WALLET_POLL_INTERVAL=60s
MAX_ALERTS_PER_USER=20
MAX_WALLETS_PER_USER=10
NOTIFY_BATCH_LIMIT=5
EVENT_RETENTION=336h
