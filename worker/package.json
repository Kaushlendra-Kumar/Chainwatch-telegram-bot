{
  "name": "chainwatch-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788 --test-scheduled",
    "poll": "node scripts/poll.mjs",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply chainwatch --remote",
    "db:migrate:local": "wrangler d1 migrations apply chainwatch --local",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
